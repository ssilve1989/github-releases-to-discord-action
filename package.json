{
  "name": "pnpm-template-repository",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm rimraf dist && pnpm build:ts",
    "ci": "biome ci --diagnostic-level=error .",
    "check": "biome check .",
    "commit": "cz",
    "format": "biome format --write .",
    "lint": "biome lint --diagnostic-level=error .",
    "test": "vitest --passWithNoTests",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/cz-commitlint": "^20.5.1",
    "@commitlint/prompt-cli": "^20.5.0",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.4"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@octokit/webhooks-types": "^7.0.0"
  }
}
