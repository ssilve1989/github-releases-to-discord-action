{
  "name": "pnpm-template-repository",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm rimraf dist && pnpm build:ts",
    "ci": "biome ci --diagnostic-level=error .",
    "check": "biome check .",
    "commit": "cz",
    "format": "biome format --write .",
    "lint": "biome lint --diagnostic-level=error .",
    "test": "vitest --passWithNoTests",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@commitlint/prompt-cli": "^20.1.0",
    "@types/node": "^24.10.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.8",
    "vitest": "^4.0.8"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@octokit/webhooks-definitions": "^3.67.3"
  }
}
